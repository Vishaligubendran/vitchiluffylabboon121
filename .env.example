# App URLs (used in email links)
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:3000

# ─── Email (required for inbox delivery to ANY address) ───
# Run: npm run email:setup

# auto | smtp | resend
EMAIL_PROVIDER=auto
EMAIL_FROM=your-sender@example.com
EMAIL_FROM_NAME=247 Shop

# Option A — Brevo (free, sends to Gmail/Outlook/Yahoo/any inbox)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-login-email
# SMTP_PASS=your-brevo-smtp-key

# Option B — Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=gmail-app-password

# Option C — Resend API (https://resend.com)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=247 Shop <onboarding@resend.dev>
