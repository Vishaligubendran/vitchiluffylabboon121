# ─── Server ───
PORT=3000
NODE_ENV=development

# ─── Auth (required) ───
JWT_SECRET=change-me-min-32-characters-random-string
JWT_EXPIRES_IN=7d

# ─── Firebase (required) ───
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ─── URLs (production: use real Vercel + API URLs) ───
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:3000

# ─── Google Sign-In ───
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ─── Email (Gmail example) ───
EMAIL_PROVIDER=smtp
EMAIL_FROM=your@gmail.com
EMAIL_FROM_NAME=247 Shop
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password

# Optional: Resend instead of SMTP
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=247 Shop <onboarding@resend.dev>

# ─── Uploads / Admin seed (optional) ───
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@247shop.com
ADMIN_PASSWORD=Admin@123456
